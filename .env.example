# ─────────────────────────────────────────────────────────────
# EcoP — environment configuration
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local`. Only this example is checked in.
# ─────────────────────────────────────────────────────────────

# Public Supabase URL (Project URL from Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe to expose to the browser; protected by RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key (FULL ACCESS). Server-only — NEVER import in client code.
# Used in API routes + Postgres SECURITY DEFINER function calls.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Do not enable this outside an explicitly labelled local simulation.
ECOP_DEMO_MODE=false

# Local Live AI Demo only. The browser never receives either value: Next.js
# proxies the authenticated stream server-to-server. Keep false in production.
ECOP_LIVE_DEMO_LOCAL=false
ECOP_AWARENESS_ENGINE_URL=http://127.0.0.1:8000
ECOP_AWARENESS_ENGINE_API_KEY=replace-with-the-local-engine-api-key

# Device identity to secret mapping for the v2 Awareness Engine gateway.
# Keep this server-only. Generate a different random secret (at least 32 bytes)
# for every provisioned edge device; never put it in a browser, QR code, or git.
ECOP_DEVICE_KEYS={"camera-01":"replace-with-a-unique-long-random-device-secret"}

# Legacy v1 integrations must be migrated to the signed device v2 contract.
# It is retained only to avoid an accidental unset variable during migration;
# current API routes do not accept v1 bin-only events.
AWARENESS_ENGINE_WEBHOOK_SECRET=replace-with-a-long-random-string

# Public site URL (used for auth redirects + absolute links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
